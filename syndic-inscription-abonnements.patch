+          ) : (
+            <p>
+              <I18nText text="Le RIB sera bientôt disponible. Contactez-nous pour l’obtenir." />
+            </p>
+          )}
+          <h3 style={{ marginTop: 20 }}>
+            <I18nText text="Tarifs" />
+          </h3>
+          <p>
+            <I18nText text="Standard : 30 DH par mois." />
