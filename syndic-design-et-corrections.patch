+}
+.dash-hero h1 {
+  margin: 6px 0 4px;
+  font-size: clamp(26px, 4vw, 34px);
+  letter-spacing: -0.8px;
+}
+.dash-hero p {
+  margin: 0;
+  color: var(--muted);
+}
+.dash-alert {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 12px 16px;
+  border-radius: 14px;
+  background: #fef6e0;
+  border: 1px solid #f6d98f;
+  color: #7a4c00;
+  margin-bottom: 16px;
+  text-decoration: none;
+}
+.dash-alert span {
+  flex: 1;
+}
+.dash-stats {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 14px;
+  margin-bottom: 18px;
+}
+.dash-stat {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding: 18px;
+}
+.dash-stat p {
+  margin: 0;
+  font-size: 13px;
+  color: var(--muted);
+}
+.dash-stat strong {
+  font-size: 22px;
+  letter-spacing: -0.5px;
+}
+.dash-icon {
+  width: 42px;
+  height: 42px;
+  flex: 0 0 42px;
+  border-radius: 12px;
+  display: grid;
+  place-items: center;
+  background: var(--primary-soft);
+  color: var(--primary);
+}
+.card .dash-icon svg {
+  color: inherit;
+}
+.dash-stat.blue .dash-icon { background: #e8f1fd; color: #1d4ed8; }
+.dash-stat.violet .dash-icon { background: #f1ecfd; color: #6d28d9; }
+.dash-stat.amber .dash-icon { background: #fef3c7; color: #b45309; }
+.dash-grid {
+  display: grid;
+  grid-template-columns: 1.4fr 1fr;
+  gap: 18px;
+  margin-bottom: 18px;
+}
+.dash-section-head {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+}
+.dash-buildings,
+.dash-actions {
+  display: grid;
+  gap: 8px;
+  margin-top: 6px;
+}
+.dash-building,
+.dash-action {
