+}
+@media (max-width: 420px) {
+  .dash-stat {
+    padding: 14px;
+    gap: 10px;
+  }
+  .dash-stat strong {
+    font-size: 18px;
+  }
+}
+@media (max-width: 800px) {
+  /* Keep the main button in the home page menu on phones */
+  .landing-nav nav > a.primary {
+    display: inline-flex;
+  }
+  .landing-nav nav {
+    gap: 8px;
+  }
+  /* The floating card covered the hero labels on small screens */
+  .hero-floating {
+    display: none;
+  }
+  .landing-hero {
+    min-height: 600px;
+  }
+}
+@media (max-width: 800px) {
+  .landing-nav nav > a.primary {
+    white-space: nowrap;
+    padding: 10px 14px;
+  }
+}
