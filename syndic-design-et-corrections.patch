+  min-width: 0;
+  display: grid;
+}
+.dash-building small,
+.dash-action small {
+  color: var(--muted);
+  font-size: 13px;
+}
+.card .dash-building > svg {
+  color: var(--muted);
+}
+.empty-state {
+  display: grid;
+  justify-items: center;
+  text-align: center;
+  gap: 10px;
+  padding: 24px 8px;
+  color: var(--muted);
+}
+.card .empty-state > svg {
+  color: #a3b8ae;
+}
+@media (max-width: 900px) {
+  .dash-stats {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
