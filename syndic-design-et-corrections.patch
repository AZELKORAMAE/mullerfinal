+.residence-tabs a:hover {
+  background: #eef4f1;
+  color: var(--ink);
+}
+.residence-tabs a.selected,
+.residence-tabs a[aria-current="page"] {
+  background: var(--primary);
+  color: #fff;
+  text-decoration: none;
+}
+.tabs-signout {
+  margin-inline-start: auto;
+}
+/* Syndic dashboard */
+.dash-hero {
+  display: flex;
+  justify-content: space-between;
